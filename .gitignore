# Dependencies
node_modules/

# The exercise media dataset, cloned by hand and never committed. It is 296 MB of
# other people's animations; only the ~30 files the app actually uses are copied
# out of it into public/exercise-media/. See tools/exercise-media/README.md.
vendor/

# Build output
dist/
dist-ssr/
*.local

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage
coverage/

# Environment — never commit real secrets
.env
.env.local
.env.*.local

# Firebase CLI local state
.firebase/
firebase-debug.log
firestore-debug.log

# Service account keys. Nothing here generates one — the only key that exists is a
# GitHub Actions secret and never touches a working copy — but the filenames the
# Google console hands out are covered in case one is ever downloaded by accident.
# See docs/DATA_MODEL.md section 5.
serviceAccount*.json
service-account*.json
*-firebase-adminsdk-*.json
gcloud-service-key.json

# Local Claude Code settings (machine-specific). launch.json IS committed, since
# it tells any future session how to start the dev server.
.claude/settings.local.json
